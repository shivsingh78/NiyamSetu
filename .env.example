# Copy to .env and add your API key to enable LLM-grounded RAG.
# Never commit .env or a real API key.
NIYAMSETU_API_KEY=
# DeepSeek official OpenAI-compatible API default:
NIYAMSETU_LLM_BASE_URL=https://api.deepseek.com
NIYAMSETU_LLM_MODEL=deepseek-flash
NIYAMSETU_LLM_TIMEOUT=35
NIYAMSETU_LLM_PROVIDER_LABEL=DeepSeek
# To use another OpenAI-compatible endpoint, change BASE_URL, MODEL and API_KEY.
